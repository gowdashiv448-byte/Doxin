{
  "name": "doxin",
  "version": "1.0.0",
  "private": true,
  "description": "Doxin — end-to-end logistics operations platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @doxin/api",
    "dev:web": "npm run dev -w @doxin/web",
    "build": "npm run build -w @doxin/shared && npm run build -w @doxin/api && npm run build -w @doxin/web",
    "test": "npm run test -w @doxin/api",
    "typecheck": "npm run typecheck -w @doxin/shared && npm run typecheck -w @doxin/api && npm run typecheck -w @doxin/web",
    "db:migrate": "npm run db:migrate -w @doxin/api",
    "db:seed": "npm run db:seed -w @doxin/api",
    "import:archive": "npm run import:archive -w @doxin/api",
    "lint": "npm run lint -w @doxin/web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  }
}
