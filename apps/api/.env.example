NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Runtime role: NOSUPERUSER, NOBYPASSRLS. Migrations use the owner URL below.
# On Render, omit DATABASE_URL: it is derived from MIGRATION_DATABASE_URL and
# APP_DB_PASSWORD so the owner credentials never reach the runtime pool.
DATABASE_URL=postgres://doxin_app:doxin_app_dev_password@localhost:5433/doxin
MIGRATION_DATABASE_URL=postgres://doxin:doxin_dev_password@localhost:5433/doxin
APP_DB_PASSWORD=doxin_app_dev_password
# auto = TLS outside localhost in production; true/false forces the choice.
# Use false for Render's internal/private-network connection.
DATABASE_SSL=auto

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-please-32-characters-minimum
JWT_EXPIRES_IN=12h

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Bootstrap administrator created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@doxin.com
SEED_ADMIN_PASSWORD=Doxin@2026

# Platform and second-tenant seed accounts. Defaults are refused in production.
SEED_PLATFORM_EMAIL=platform@doxin.com
SEED_PLATFORM_PASSWORD=Platform@2026
SEED_SECOND_TENANT_NAME=Northwind Logistics
SEED_SECOND_TENANT_SLUG=northwind
SEED_SECOND_TENANT_EMAIL=admin@northwind.test
SEED_SECOND_TENANT_PASSWORD=Northwind@2026

# Set false before the first boot when importing the archive into an empty
# tenant. Starter demo rows otherwise claim the low CUST/TRK/TRL/LOAD IDs.
SEED_STARTER_DATA=true
