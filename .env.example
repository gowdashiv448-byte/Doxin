# Copy to .env before `docker compose up -d`, then change these values.
# Generate a secret with: openssl rand -hex 32
POSTGRES_PASSWORD=doxin_dev_password
# Password for the runtime doxin_app role (NOSUPERUSER / NOBYPASSRLS).
APP_DB_PASSWORD=doxin_app_dev_password
JWT_SECRET=replace-this-with-a-random-64-character-secret-before-production
JWT_EXPIRES_IN=12h
# false for the bundled Postgres; true for a managed database that requires TLS.
DATABASE_SSL=false

WEB_PORT=8080
POSTGRES_PORT=5433
CORS_ORIGIN=http://localhost:8080

SEED_ADMIN_EMAIL=admin@doxin.com
SEED_ADMIN_PASSWORD=Doxin@2026
SEED_PLATFORM_EMAIL=platform@doxin.com
SEED_PLATFORM_PASSWORD=Platform@2026
SEED_SECOND_TENANT_NAME=Northwind Logistics
SEED_SECOND_TENANT_SLUG=northwind
SEED_SECOND_TENANT_EMAIL=admin@northwind.test
SEED_SECOND_TENANT_PASSWORD=Northwind@2026
# Set false before the first boot if you will import the archive instead of
# using the starter demo customers, drivers, trucks and trailers.
SEED_STARTER_DATA=true
LOG_LEVEL=info
